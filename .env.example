DATABASE_URL="postgresql://ihub:ihub@localhost:5432/ihub"
STORAGE_DIR="./storage"
SESSION_DAYS="30"
# Хостингте (Vercel) файлдарды Supabase Storage-та сақтау үшін:
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."   # тек серверде, ешқашан браузерге берілмейді
# SUPABASE_BUCKET="files"           # жабық (private) bucket
# Бірінші әкімші (seed кезінде жасалады):
# ADMIN_EMAIL="..."
# ADMIN_PASSWORD="..."
# APP_URL="https://your-site.vercel.app"
# Робот таза қазақша сөйлеуі үшін (Azure Speech, тегін деңгей F0 жеткілікті):
# AZURE_SPEECH_KEY="..."
# AZURE_SPEECH_REGION="westeurope"
# AZURE_SPEECH_VOICE="kk-KZ-AigulNeural"   # ер дауыс: kk-KZ-DauletNeural
