generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Пайдаланушылар және рөлдер ----------

model Role {
  id    Int    @id @default(autoincrement())
  key   String @unique // USER | ADMIN
  name  String
  users User[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarPath   String?
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  blocked      Boolean   @default(false)
  soundOn      Boolean   @default(true)
  voiceOn      Boolean   @default(true)
  notifyOn     Boolean   @default(true)
  profilePublic Boolean  @default(false)
  theme        String?   // light | dark | read
  lang         String?   // kk | ru | en
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  materials     Material[]     @relation("MaterialAuthor")
  favorites     Favorite[]
  reviews       Review[]
  comments      Comment[]
  history       UserHistory[]
  notifications Notification[]
  gameResults   GameResult[]
  studentResults StudentResult[]
  authoredGames Game[] @relation("AuthoredGames")
  liveSessions  LiveSession[]
  classrooms    Classroom[]
  resetTokens   PasswordResetToken[]
}

model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ---------- Оқу бағдарламасы ----------

model Grade {
  id          Int          @id // 5..11
  title       String
  quarters    Quarter[]
  materials   Material[]
  assessments Assessment[]
  games       Game[]
}

model Quarter {
  id          Int          @id @default(autoincrement())
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  number      Int // 1..4
  topics      Topic[]
  materials   Material[]
  assessments Assessment[]

  @@unique([gradeId, number])
}

model Topic {
  id          Int          @id @default(autoincrement())
  quarterId   Int
  quarter     Quarter      @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  section     String? // бөлім, мысалы «Python программалау»
  title       String
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  materials   Material[]
  assessments Assessment[]
  games       Game[]

  @@index([quarterId])
}

// ---------- Материалдар ----------

model MaterialType {
  id        Int        @id @default(autoincrement())
  key       String     @unique // PRESENTATION | VIDEO | PRACTICE | KMZH | RESOURCE | INTERACTIVE
  name      String
  materials Material[]
}

model Material {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  typeId      Int
  type        MaterialType @relation(fields: [typeId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  quarterId   Int
  quarter     Quarter      @relation(fields: [quarterId], references: [id])
  topicId     Int?
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  filePath    String? // storage ішіндегі жол
  fileName    String?
  fileMime    String?
  fileSize    Int?
  previewPath String? // PDF алдын ала қарау нұсқасы (PPTX/DOCX үшін)
  videoUrl    String? // YouTube т.б. сілтеме
  externalUrl String?

  views       Int          @default(0)
  downloads   Int          @default(0)
  ratingAvg   Float        @default(0)
  ratingCount Int          @default(0)
  published   Boolean      @default(false)

  authorId    String?
  author      User?        @relation("MaterialAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  favorites   Favorite[]
  reviews     Review[]
  comments    Comment[]
  history     UserHistory[]

  @@index([gradeId, quarterId])
  @@index([typeId])
  @@index([published, createdAt])
}

// ---------- БЖБ / ТЖБ ----------

enum AssessmentKind {
  BZHB
  TZHB
}

model Assessment {
  id          String         @id @default(cuid())
  kind        AssessmentKind
  title       String
  description String         @default("")
  gradeId     Int
  grade       Grade          @relation(fields: [gradeId], references: [id])
  quarterId   Int
  quarter     Quarter        @relation(fields: [quarterId], references: [id])
  topicId     Int?
  topic       Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  variant     String         @default("1-нұсқа")

  filePath    String?
  fileName    String?
  fileMime    String?
  fileSize    Int?
  previewPath String?

  answers     String? // жауаптар мәтіні
  answersPath String? // жауаптар файлы
  criteria    String? // бағалау критерийлері
  descriptors String? // дескрипторлар

  views       Int            @default(0)
  downloads   Int            @default(0)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  favorites   Favorite[]
  comments    Comment[]
  history     UserHistory[]

  @@index([kind, gradeId, quarterId])
}

// ---------- Ойындар ----------

enum GameType {
  QUIZ
  MATCHING
  CROSSWORD
  RAPID
  LOGIC
  CODING
  TRUEFALSE
  CLIMB
  ORDERING
  MEMORY
  MAZE
  PIXEL
  SHOOTER
  ESCAPE
  TUGOFWAR
  DUEL
  CIPHER
  LIVE
  BOARD
  TEAMESCAPE
}

model Game {
  id          String         @id @default(cuid())
  type        GameType
  title       String
  description String         @default("")
  gradeId     Int
  grade       Grade          @relation(fields: [gradeId], references: [id])
  topicId     Int?
  topic       Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  timeLimit   Int? // секунд (RAPID үшін бір сұраққа)
  published   Boolean        @default(false)
  /// null — сайттың ресми ойыны; әйтпесе ойынды жасаған мұғалім (тек өзі және сілтеме арқылы оқушылары көреді)
  authorId    String?
  author      User?          @relation("AuthoredGames", fields: [authorId], references: [id], onDelete: Cascade)
  plays       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions   GameQuestion[]
  favorites   Favorite[]
  results     GameResult[]
  studentResults StudentResult[]
  liveSessions   LiveSession[]
  duels          Duel[]
  classGames     ClassGame[]

  @@index([type, gradeId])
}

model GameQuestion {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  prompt      String
  // Түріне қарай: options (string[]), pairs ({left,right}[]), т.б.
  data        Json     @default("{}")
  // Дұрыс жауап: индекс, мәтін, т.б. Клиентке ойын кезінде жіберілмейді.
  answer      Json
  explanation String?
  points      Int      @default(1)

  @@index([gameId])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  score     Int
  maxScore  Int
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Пайдаланушы әрекеттері ----------

model Favorite {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  gameId       String?
  game         Game?       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, materialId])
  @@unique([userId, assessmentId])
  @@unique([userId, gameId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, materialId])
}

model Comment {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  text         String
  hidden       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([materialId])
  @@index([assessmentId])
}

enum HistoryAction {
  VIEW
  DOWNLOAD
}

model UserHistory {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       HistoryAction
  materialId   String?
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  createdAt DateTime @default(now())
}

/// Мұғалім сілтемемен жіберген ойынды оқушы тіркелмей ойнағандағы нәтиже.
model StudentResult {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentName String
  className   String   @default("")
  /// «Менің сыныптарым»: оқушы сынып сілтемесі арқылы ойнаса
  classId     String?
  classroom   Classroom?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentId   String?
  student     ClassStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  score       Int
  maxScore    Int
  createdAt   DateTime @default(now())

  @@index([teacherId, gameId])
  @@index([classId])
}

// ---------- Менің сыныптарым ----------

/// Мұғалімнің сыныбы (мысалы, 7 «А»): оқушылар тізімі, берілген ойындар, бағалар журналы.
model Classroom {
  id        String          @id @default(cuid())
  teacherId String
  teacher   User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  gradeId   Int
  createdAt DateTime        @default(now())
  students  ClassStudent[]
  games     ClassGame[]
  results   StudentResult[]
  columns   ClassColumn[]

  @@index([teacherId])
}

/// Мұғалім журналға өзі қосатын баған (мысалы, «Үй жұмысы», «Ауызша жауап»): балды қолмен қояды.
model ClassColumn {
  id        String      @id @default(cuid())
  classId   String
  classroom Classroom   @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  maxScore  Int         @default(10)
  createdAt DateTime    @default(now())
  marks     ClassMark[]

  @@index([classId])
}

model ClassMark {
  id        String       @id @default(cuid())
  columnId  String
  column    ClassColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  studentId String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int

  @@unique([columnId, studentId])
}

model ClassStudent {
  id        String          @id @default(cuid())
  classId   String
  classroom Classroom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  results   StudentResult[]
  marks     ClassMark[]

  @@unique([classId, name])
}

/// Сыныпқа берілген ойын
model ClassGame {
  id        String    @id @default(cuid())
  classId   String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// 0 — шексіз; әйтпесе бір оқушыға рұқсат етілген ойнау саны
  attempts  Int       @default(0)
  /// журналға қай нәтиже түседі: best | first | last
  countMode String    @default("best")
  /// осы уақыттан кейін сілтеме жабылады
  dueAt     DateTime?
  createdAt DateTime  @default(now())

  @@unique([classId, gameId])
}

/// Тірі ойын (Сынып жарысы, Командалық қашу бөлмесі): мұғалім тақтада жүргізеді, оқушылар кодпен телефоннан кіреді.
model LiveSession {
  id        String       @id @default(cuid())
  code      String       @unique
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hostId    String
  host      User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// lobby | question | reveal | ended
  state     String       @default("lobby")
  current   Int          @default(-1)
  startedAt DateTime?
  /// 0 — әркім өзі үшін; 2–6 — командалар саны
  teams     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  players   LivePlayer[]
  answers   LiveAnswer[]

  @@index([hostId])
}

model LivePlayer {
  id        String       @id @default(cuid())
  sessionId String
  session   LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  team      Int          @default(0)
  score     Int          @default(0)
  /// мұғалім қолмен қосқан/алған балл
  bonus     Int          @default(0)
  joinedAt  DateTime     @default(now())
  answers   LiveAnswer[]

  @@unique([sessionId, name])
}

model LiveAnswer {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    LivePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  qIndex    Int
  value     Json
  correct   Boolean
  points    Int         @default(0)
  ms        Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([sessionId, qIndex])
}

/// Дуэль: бірінші оқушы ойнап, досына сілтеме жібереді; екіншісі сол сұрақтарға жауап береді.
model Duel {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teacherId String?
  aName     String
  aScore    Int
  aMs       Int
  bName     String?
  bScore    Int?
  bMs       Int?
  createdAt DateTime @default(now())
}
